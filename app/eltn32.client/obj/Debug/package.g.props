<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PackageJsonName Condition="$(PackageJsonName) == ''">eltn32.client</PackageJsonName>
    <PackageJsonVersion Condition="$(PackageJsonVersion) == ''">1.0.0</PackageJsonVersion>
    <PackageJsonPrivate Condition="$(PackageJsonPrivate) == ''">true</PackageJsonPrivate>
    <PackageJsonScriptsDev Condition="$(PackageJsonScriptsDev) == ''">next dev -p 3000</PackageJsonScriptsDev>
    <PackageJsonScriptsBuild Condition="$(PackageJsonScriptsBuild) == ''">next build</PackageJsonScriptsBuild>
    <PackageJsonScriptsBuildExport Condition="$(PackageJsonScriptsBuildExport) == ''">next build</PackageJsonScriptsBuildExport>
    <PackageJsonScriptsStart Condition="$(PackageJsonScriptsStart) == ''">next start -p 3000</PackageJsonScriptsStart>
    <PackageJsonScriptsExportCopy Condition="$(PackageJsonScriptsExportCopy) == ''">npm run build:export &amp;&amp; node ./scripts/copy-out-to-wwwroot.js</PackageJsonScriptsExportCopy>
    <PackageJsonDependenciesNext Condition="$(PackageJsonDependenciesNext) == ''">^14.2.0</PackageJsonDependenciesNext>
    <PackageJsonDependenciesReact Condition="$(PackageJsonDependenciesReact) == ''">^18.2.0</PackageJsonDependenciesReact>
    <PackageJsonDependenciesReactDom Condition="$(PackageJsonDependenciesReactDom) == ''">^18.2.0</PackageJsonDependenciesReactDom>
    <PackageJsonDevdependenciesTypesNode Condition="$(PackageJsonDevdependenciesTypesNode) == ''">^20.0.0</PackageJsonDevdependenciesTypesNode>
    <PackageJsonDevdependenciesTypesReact Condition="$(PackageJsonDevdependenciesTypesReact) == ''">^18.2.0</PackageJsonDevdependenciesTypesReact>
    <PackageJsonDevdependenciesTypesReactDom Condition="$(PackageJsonDevdependenciesTypesReactDom) == ''">^18.2.0</PackageJsonDevdependenciesTypesReactDom>
    <PackageJsonDevdependenciesAutoprefixer Condition="$(PackageJsonDevdependenciesAutoprefixer) == ''">^10.4.16</PackageJsonDevdependenciesAutoprefixer>
    <PackageJsonDevdependenciesPostcss Condition="$(PackageJsonDevdependenciesPostcss) == ''">^8.4.32</PackageJsonDevdependenciesPostcss>
    <PackageJsonDevdependenciesTailwindcss Condition="$(PackageJsonDevdependenciesTailwindcss) == ''">^3.4.0</PackageJsonDevdependenciesTailwindcss>
    <PackageJsonDevdependenciesTypescript Condition="$(PackageJsonDevdependenciesTypescript) == ''">^5.3.0</PackageJsonDevdependenciesTypescript>
    <PackageJsonNextconfigOutput Condition="$(PackageJsonNextconfigOutput) == ''">export</PackageJsonNextconfigOutput>
    <PackageJsonNextconfigDistdir Condition="$(PackageJsonNextconfigDistdir) == ''">.next</PackageJsonNextconfigDistdir>
    <PackageJsonNextconfigImagesUnoptimized Condition="$(PackageJsonNextconfigImagesUnoptimized) == ''">true</PackageJsonNextconfigImagesUnoptimized>
    <PackageJsonNextconfigTrailingslash Condition="$(PackageJsonNextconfigTrailingslash) == ''">true</PackageJsonNextconfigTrailingslash>
  </PropertyGroup>
</Project>